# Email notification sent (from the server only) when the "Yes" button is pressed.
# Copy this file to .env.local for local development, and add the same
# variables in the hosting dashboard (e.g. Vercel -> Settings -> Environment Variables).

# Secret API key of the email service (Resend, https://resend.com). Never expose it to the browser.
EMAIL_SERVICE_API_KEY=

# Who receives the notification.
EMAIL_TO=nekruzhakimov320@gmail.com

# Sender address. Leave as is until you verify your own domain in Resend.
# (With the default sender Resend delivers only to the email the Resend account was created with.)
EMAIL_FROM=Letter <onboarding@resend.dev>

# Optional: time zone used to print the time inside the notification (IANA name), default UTC.
EMAIL_TIMEZONE=UTC
